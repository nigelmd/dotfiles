#!/usr/bin/env bash
# Fetch a named secret from the OS keystore.
# macOS: Keychain (security)
# Linux: pass (preferred) -> secret-tool (fallback)
# Exits 0 with secret on stdout; non-zero on missing/unsupported.
set -euo pipefail
name="${1:?usage: get-secret <name>}"
case "$(uname -s)" in
    Darwin)
        security find-generic-password -a "$USER" -s "$name" -w
        ;;
    Linux)
        if command -v pass >/dev/null 2>&1; then
            pass show "$name"
        elif command -v secret-tool >/dev/null 2>&1; then
            secret-tool lookup service "$name"
        else
            echo "get-secret: no secret store available — install 'pass' or libsecret" >&2
            exit 1
        fi
        ;;
    *)
        echo "get-secret: unsupported OS: $(uname -s)" >&2
        exit 1
        ;;
esac
