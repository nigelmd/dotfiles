#!/bin/bash
# pick-agent — fzf list of tmux panes running claude or codex; jump to the chosen one.
# Claude sets the pane title to "✳ <conversation>", so the rows read well.
# Runs inside `tmux display-popup -E`, so switch-client targets the popup's client.
list() {
  tmux list-panes -a -F $'#{pane_pid}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_title}\t#{pane_current_path}' |
    while IFS=$'\t' read -r pid target title path; do
      kids=$(pgrep -d, -P "$pid") || continue
      cmd=$(ps -o args= -p "$kids" 2>/dev/null)
      case "$cmd" in
        *claude*) tag=claude ;;
        *codex*) tag=codex ;;
        *) continue ;;
      esac
      printf '%s\t%s\t%s\t%s\n' "$target" "$tag" "$title" "${path/#$HOME/~}"
    done
}
[ "$1" = --list ] && { list; exit; }
sel=$(list | column -ts $'\t' | fzf --no-sort --ansi --border-label ' agents ' --prompt '✳  ' \
  --header 'claude / codex panes' | awk '{print $1}')
[ -z "$sel" ] && exit 0
tmux switch-client -t "${sel%%:*}" && tmux select-window -t "${sel%.*}" && tmux select-pane -t "$sel"
