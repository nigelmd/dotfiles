#!/bin/bash
# theme — single source of truth for latte/mocha. Writes ~/.config/theme, then
# re-themes tmux and announces the flavor to every attached wezterm (local or
# over ssh) via an OSC 1337 user var. wezterm and nvim watch the file; Claude
# Code live-reloads ~/.claude/themes/current.json.
set -e
FILE="$HOME/.config/theme"
cur=$(cat "$FILE" 2>/dev/null || echo mocha)
case "${1:-toggle}" in
  latte|mocha) new=$1 ;;
  toggle) if [ "$cur" = mocha ]; then new=latte; else new=mocha; fi ;;
  push) new=$cur ;; # announce only (tmux client-attached hook)
  *) echo "usage: theme [latte|mocha|toggle|push]" >&2; exit 2 ;;
esac
tmux info >/dev/null 2>&1 && in_tmux=1 || in_tmux=

if [ "$new" != "$cur" ] || [ ! -f "$FILE" ]; then
  mkdir -p "$(dirname "$FILE")"
  echo "$new" > "$FILE"
  [ -f "$HOME/.claude/themes/$new.json" ] && cp "$HOME/.claude/themes/$new.json" "$HOME/.claude/themes/current.json"
  if [ -n "$in_tmux" ]; then
    tmux set -g @catppuccin_flavor "$new"
    # catppuccin sets @thm_* with -o (never overwrite): unset them, then let the
    # plugin reload them. Everything else in .tmux.conf reads @thm_* at render time.
    tmux show -g | awk '/^@thm_/{print "set -gu", $1}' | tmux source-file -
    ~/.tmux/plugins/tmux/catppuccin.tmux
  fi
fi

if [ -n "$in_tmux" ]; then
  b64=$(printf %s "$new" | base64)
  for tty in $(tmux list-clients -F '#{client_tty}'); do
    printf '\033]1337;SetUserVar=THEME=%s\007' "$b64" > "$tty" 2>/dev/null || true
  done
fi
